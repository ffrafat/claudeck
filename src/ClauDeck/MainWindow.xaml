<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClauDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClauDeck">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="ClauDeck" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="280"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="OnSelectionChanged"
            ItemInvoked="OnItemInvoked">

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Add account" Tag="add" SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AddFriend" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />
                <InfoBar
                    x:Name="Notice"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="24"
                    MaxWidth="640"
                    IsClosable="True"
                    Severity="Informational" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
