<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClauDeck.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Follow Windows, or always light or dark" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnThemeChanged">
                        <ComboBoxItem Content="Use system setting" Tag="system" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE771;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Window background" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Mica tints the window with your wallpaper, like Settings. Acrylic shows a blur of what is behind it." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="BackdropBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="OnBackdropChanged">
                        <ComboBoxItem Content="Mica" Tag="mica" />
                        <ComboBoxItem Content="Mica Alt" Tag="micaalt" />
                        <ComboBoxItem Content="Acrylic" Tag="acrylic" />
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE768;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Starts in the notification area, ready to open any account" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" Toggled="OnStartupToggled" />
                </Grid>
            </Border>

            <TextBlock Text="Data" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Accounts folder" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock x:Name="RootText" Style="{StaticResource CardDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open folder" Click="OnOpenRoot" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Exit ClauDeck" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Closing the window only hides it; this stops the launcher. Your Claude windows stay open." Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Exit" Click="OnExit" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
