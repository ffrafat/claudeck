<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClauDeck.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="36,8,36,36" MaxWidth="1000" HorizontalAlignment="Stretch" Spacing="4">

            <!-- Header, the way Settings shows an account at the top of its page. -->
            <Grid ColumnSpacing="18" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{x:Bind ViewModel.Badge, Mode=OneWay}" Width="64" Height="64" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Style="{StaticResource EditButtonStyle}" Click="OnRename" ToolTipService.ToolTip="Rename" AutomationProperties.Name="Rename">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ProblemText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>

                <!-- Start when its Claude is not running; while it runs: bring to front, status, Stop. -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Start" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="OnStart"
                            Visibility="{x:Bind ViewModel.ShowStart, Mode=OneWay}" ToolTipService.ToolTip="Start this account's Claude window" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowStarting, Mode=OneWay}">
                        <ProgressRing IsActive="{x:Bind ViewModel.ShowStarting, Mode=OneWay}" Width="18" Height="18" />
                        <TextBlock Text="Starting…" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind ViewModel.ShowRunning, Mode=OneWay}">
                        <Button Style="{StaticResource EditButtonStyle}" Click="OnFront" ToolTipService.ToolTip="Bring this Claude window to the front" AutomationProperties.Name="Bring to front">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                        </Button>
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RunningText, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,8,0" />
                        <Button Content="Stop" MinWidth="96" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}" Click="OnStop"
                                ToolTipService.ToolTip="Quit this account's Claude completely" />
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Text="Usage" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE916;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Session (5 hours)" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SessionResets, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar Width="200" Maximum="100" Value="{x:Bind ViewModel.SessionValue, Mode=OneWay}" ShowError="{x:Bind ViewModel.SessionHigh, Mode=OneWay}" ShowPaused="{x:Bind ViewModel.SessionRaised, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.SessionPercent, Mode=OneWay}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE787;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Weekly" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.WeeklyResets, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressBar Width="200" Maximum="100" Value="{x:Bind ViewModel.WeeklyValue, Mode=OneWay}" ShowError="{x:Bind ViewModel.WeeklyHigh, Mode=OneWay}" ShowPaused="{x:Bind ViewModel.WeeklyRaised, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.WeeklyPercent, Mode=OneWay}" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D2;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="This week" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LimitsSource, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.WeekBreakdown, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Extra usage" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Credits used once the plan's limits are reached" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ExtraUsage, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <TextBlock Text="Profile" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Code chats" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Claude Code sessions this account lists" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.CodeChats, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE823;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Last used" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.LastUsed, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Profile folder" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Folder, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Open folder" Click="OnOpenFolder" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Manage" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8AC;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Name" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Only the label changes; the sign-in and chats stay as they are" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Rename" Click="OnRename" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Avatar colour" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ColorName, Mode=OneWay}" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <VariableSizedWrapGrid x:Name="Swatches" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" ItemWidth="48" ItemHeight="48" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsNotMain, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE71B;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Desktop and Start shortcut" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Opens this account directly, without this window" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ShortcutToggle" Grid.Column="2" IsOn="{x:Bind ViewModel.HasShortcut, Mode=OneWay}" Toggled="OnShortcutToggled" MinWidth="0" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsNotMain, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Remove from ClauDeck" Style="{StaticResource CardTitleStyle}" />
                        <TextBlock Text="Its folder and sign-in are kept, so nothing is lost" Style="{StaticResource CardDescriptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Remove" Click="OnRemove" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.IsMain, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center"
                               Text="This is the ordinary Claude app, the one in Start. It keeps its own shortcut and is never removed from here." />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
